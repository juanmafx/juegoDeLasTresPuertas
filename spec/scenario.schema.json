{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juanmafx/juegoDeLasTresPuertas/spec/scenario.schema.json",
  "title": "Monty Hall lab scenarios",
  "description": "A scenario and the shared scenario file. Cross-field rules that JSON Schema cannot express are listed in spec/cli.md under Validation.",
  "type": "object",
  "required": [
    "version",
    "description",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "minItems": 40,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "fraction": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)/[1-9][0-9]*$"
    },
    "probability": {
      "type": "string",
      "pattern": "^(0/1|1/1|[1-9][0-9]*/[1-9][0-9]*)$"
    },
    "nullableProbability": {
      "oneOf": [
        {
          "$ref": "#/$defs/probability"
        },
        {
          "type": "null"
        }
      ]
    },
    "weights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "doors",
        "prizes",
        "prior",
        "pick",
        "reveals",
        "host",
        "host_weights",
        "mixed",
        "observed"
      ],
      "additionalProperties": false,
      "properties": {
        "doors": {
          "type": "integer",
          "minimum": 3,
          "maximum": 64
        },
        "prizes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 62
        },
        "prior": {
          "oneOf": [
            {
              "const": "uniform"
            },
            {
              "$ref": "#/$defs/weights"
            }
          ]
        },
        "pick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "reveals": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 62
        },
        "host": {
          "enum": [
            "informed",
            "random",
            "biased",
            "adversarial"
          ]
        },
        "host_weights": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/weights"
                },
                {
                  "items": {
                    "minimum": 1
                  }
                }
              ]
            }
          ]
        },
        "mixed": {
          "$ref": "#/$defs/probability"
        },
        "observed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 62,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            }
          ]
        }
      }
    },
    "outcomes": {
      "type": "object",
      "required": [
        "decision",
        "void",
        "no_offer",
        "observed"
      ],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/probability"
        },
        "void": {
          "$ref": "#/$defs/probability"
        },
        "no_offer": {
          "$ref": "#/$defs/probability"
        },
        "observed": {
          "$ref": "#/$defs/nullableProbability"
        }
      }
    },
    "win": {
      "type": "object",
      "required": [
        "stay",
        "switch",
        "mixed"
      ],
      "additionalProperties": false,
      "properties": {
        "stay": {
          "$ref": "#/$defs/nullableProbability"
        },
        "switch": {
          "$ref": "#/$defs/nullableProbability"
        },
        "mixed": {
          "$ref": "#/$defs/nullableProbability"
        }
      }
    },
    "exactResult": {
      "type": "object",
      "required": [
        "prize_at_pick",
        "outcomes",
        "win"
      ],
      "additionalProperties": false,
      "properties": {
        "prize_at_pick": {
          "$ref": "#/$defs/probability"
        },
        "outcomes": {
          "$ref": "#/$defs/outcomes"
        },
        "win": {
          "$ref": "#/$defs/win"
        }
      }
    },
    "choice": {
      "type": "object",
      "required": [
        "reveals",
        "value",
        "regret"
      ],
      "additionalProperties": false,
      "properties": {
        "reveals": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/fraction"
        },
        "regret": {
          "$ref": "#/$defs/fraction"
        }
      }
    },
    "curve": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "reveals",
          "win",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "reveals": {
            "type": "integer",
            "minimum": 0
          },
          "win": {
            "$ref": "#/$defs/probability"
          },
          "value": {
            "$ref": "#/$defs/fraction"
          }
        }
      }
    },
    "optimum": {
      "type": "object",
      "required": [
        "reveals",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "reveals": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/fraction"
        }
      }
    },
    "parabola": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "a",
            "b",
            "c",
            "shape",
            "residual_sum_of_squares",
            "vertex",
            "vertex_offset",
            "vertex_value_gap",
            "rounded_vertex",
            "fitted_choice"
          ],
          "additionalProperties": false,
          "properties": {
            "a": {
              "$ref": "#/$defs/fraction"
            },
            "b": {
              "$ref": "#/$defs/fraction"
            },
            "c": {
              "$ref": "#/$defs/fraction"
            },
            "shape": {
              "enum": [
                "concave",
                "convex",
                "linear"
              ]
            },
            "residual_sum_of_squares": {
              "$ref": "#/$defs/fraction"
            },
            "vertex": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "reveals",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "reveals": {
                      "$ref": "#/$defs/fraction"
                    },
                    "value": {
                      "$ref": "#/$defs/fraction"
                    }
                  }
                }
              ]
            },
            "vertex_offset": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/fraction"
                }
              ]
            },
            "vertex_value_gap": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/fraction"
                }
              ]
            },
            "rounded_vertex": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/choice"
                }
              ]
            },
            "fitted_choice": {
              "$ref": "#/$defs/choice"
            }
          }
        }
      ]
    },
    "optimumResult": {
      "type": "object",
      "required": [
        "curve",
        "optimum",
        "parabola"
      ],
      "additionalProperties": false,
      "properties": {
        "curve": {
          "$ref": "#/$defs/curve"
        },
        "optimum": {
          "$ref": "#/$defs/optimum"
        },
        "parabola": {
          "$ref": "#/$defs/parabola"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "description",
        "scenario",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "simulation": {
          "type": "object",
          "required": [
            "seed",
            "trials"
          ],
          "additionalProperties": false,
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "trials": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            }
          }
        },
        "optimum": {
          "type": "object",
          "required": [
            "strategy",
            "cost"
          ],
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "enum": [
                "stay",
                "switch",
                "mixed"
              ]
            },
            "cost": {
              "$ref": "#/$defs/fraction"
            }
          }
        },
        "expected": {
          "type": "object",
          "required": [
            "exact_method",
            "exact"
          ],
          "additionalProperties": false,
          "properties": {
            "exact_method": {
              "enum": [
                "brute_force",
                "class_enumeration"
              ]
            },
            "exact": {
              "$ref": "#/$defs/exactResult"
            },
            "optimum_methods": {
              "type": "array",
              "items": {
                "enum": [
                  "brute_force",
                  "class_enumeration"
                ]
              }
            },
            "optimum": {
              "$ref": "#/$defs/optimumResult"
            }
          }
        }
      }
    }
  }
}
