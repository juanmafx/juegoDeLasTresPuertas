{
    "name": "juanmafx/monty-lab",
    "description": "PHP implementation of the generalized Monty Hall decision lab.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "brick/math": "1.0.0"
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.7",
        "phpunit/phpunit": "13.4.8"
    },
    "autoload": {
        "psr-4": {
            "MontyHall\\Lab\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MontyHall\\Lab\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/monty-lab"],
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true,
        "allow-plugins": false,
        "optimize-autoloader": true
    }
}
